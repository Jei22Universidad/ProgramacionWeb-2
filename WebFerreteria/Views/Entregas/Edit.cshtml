        </ul>
        <li><a href="collapsible.html">Administrar información</a></li>
        <li><a asp-area="" asp-controller="Inventarios" asp-action="Index">inventario (Stack)</a></li>
        <li><a asp-area="" asp-controller="Usuarios" asp-action="Index">Registros</a></li>
        <li><a asp-area="" asp-controller="Home" asp-action="" class="waves-effect waves-light btn">Salir</a></li>
    </ul>
    <section class="col s12 l9">

        <h4 class="center">Formulario editar a Domicilio</h4>
        <hr />
        <div class="row">
            <div class="col-md-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="EntregaId" />
                    <div class="input-field col s3">
                        <label asp-for="FechaEntrega" class="control-label"></label>
                        <input asp-for="FechaEntrega" type="text" class="datepicker" />
                        <span asp-validation-for="FechaEntrega" class="text-danger"></span>
                    </div>
                    @* <div class="form-group">
                        <label asp-for="Estado" class="control-label"></label>
                        <input asp-for="Estado" class="form-control />
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div> *@
                    <div class="input-field col s3">
                        <select asp-for="Estado" class="form-control">
                            <option value="" disabled selected>Selecione el estado</option>
                            <option value="pendiente">pendiente</option>
                            <option value="entregado">entregado</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>
                    <div class="input-field col s8">
                        <label asp-for="Observaciones" class="control-label"></label>
                        <input asp-for="Observaciones" class="form-control" />
                        <span asp-validation-for="Observaciones" class="text-danger"></span>
                    </div>
                    <div class="input-field col s4">
                        <label asp-for="PedidoId" class="control-label">Nombre del cliente</label>
                        <select asp-for="PedidoId" class="form-control" asp-items="ViewBag.PedidoId"></select>
                        <span asp-validation-for="PedidoId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <button type="submit" value="Save" class="waves-effect waves-light btn">Actualizar</button>
                        <a class="waves-effect waves-light btn" asp-action="Index">Voler a la lista</a>

                    </div>
                </form>
            </div>
        </div>


    </section>
    <br />
    <br />

    <footer class="row">
        <div class="col s12 l12">
            <p>
                Estamos ubicados en Manizales, Caldas, Colombia.<br />
