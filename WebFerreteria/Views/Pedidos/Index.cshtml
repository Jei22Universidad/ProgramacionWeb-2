@model IEnumerable<WebFerreteria.Models.Pedido>

@{
    ViewData["Title"] = "Index";
}
<body>
    <div class="col s12 l4">
        <div class="row Titulo">
            <h2>Almacen J&D</h2>
        </div>
    </div>
    <nav>
        <div class="nav-wrapper">
            <a href="#!" class="brand-logo"><img src="~/imagenes/logo.png" alt=""></a>
            <a href="#" data-target="mobile-demo" class="sidenav-trigger"><i class="material-icons">menu</i></a>
            <ul class="right hide-on-med-and-down">
                <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Inicio</a></li>
                <li><a asp-area="" asp-controller="Clientes" asp-action="Index">Registro de clientes</a></li>
                <!-- Dropdown Trigger -->
                <li><a class='dropdown-trigger ' href='#' data-target='dropdown1'>Procesar solicitudes ⮯</a></li>
                <!-- Dropdown Structure -->
                <ul id='dropdown1' class='dropdown-content'>
                    <li><a asp-area="" asp-controller="Entregas" asp-action="Index"><i class="material-icons">motorcycle</i>Entregas a Domicilio</a></li>
                    <!-- <li><a href="#!">Pedidos</a></li> -->
                    <li class="divider" tabindex="-1"></li>
                    <!-- <li><a href="#!">three</a></li> -->
                    <li><a asp-area="" asp-controller="Facturas" asp-action="Index"><i class="material-icons">assignment_returned</i>Facturacion</a></li>
                    <li><a asp-area="" asp-controller="Pedidos" asp-action="Index"><i class="material-icons">book</i>Pedidos clinetes</a></li>
                </ul>
                <!-- <li><a href="">facturación</a></li> -->
                <li><a href="">Administrar información</a></li>
                <li><a asp-area="" asp-controller="Inventarios" asp-action="Index">inventario (Stack)</a></li>
                <li><a asp-area="" asp-controller="Usuarios" asp-action="Index">Registros</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="" class="waves-effect waves-light btn">Salir</a></li>
            </ul>
        </div>
    </nav>

    <ul class="sidenav" id="mobile-demo">
        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Inicio</a></li>
        <li><a asp-area="" asp-controller="Clientes" asp-action="Index">Registro de clientes</a></li>
        <li><a class='dropdown-trigger ' href='#' data-target='dropdown2'>Procesar solicitudes ⮯</a></li>
        <!-- Dropdown Structure -->
        <ul id='dropdown2' class='dropdown-content'>
            <li><a asp-area="" asp-controller="Entregas" asp-action="Index"><i class="material-icons">motorcycle</i>Entregas a Domicilio</a></li>
            <!-- <li><a href="#!">Pedidos</a></li> -->
            <li class="divider" tabindex="-1"></li>
            <!-- <li><a href="#!">three</a></li> -->
            <li><a asp-area="" asp-controller="Facturas" asp-action="Index"><i class="material-icons">assignment_returned</i>Facturacion</a></li>
            <li><a asp-area="" asp-controller="Pedidos" asp-action="Index"><i class="material-icons">book</i>Pedidos clinetes</a></li>
        </ul>
        <li><a href="collapsible.html">Administrar información</a></li>
        <li><a asp-area="" asp-controller="Inventarios" asp-action="Index">inventario (Stack)</a></li>
        <li><a asp-area="" asp-controller="Usuarios" asp-action="Index">Registros</a></li>
        <li><a asp-area="" asp-controller="Home" asp-action="" class="waves-effect waves-light btn">Salir</a></li>
    </ul>
    <section class="col s12 l9">
        <h3 class="center">Tabla de Pedidos</h3>

        <p>
            <a class="waves-effect waves-light btn" asp-action="Create"><i class="material-icons left">archive</i> Ingreasr nuevo pedido</a>
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        Fecha del Pedido
                    </th>
                    <th>
                        Estado
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Observaciones)
                    </th>
                    <th>
                        Cantidad Solicitada
                    </th>
                    <th>
                        Nombre del cliente
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Producto)
                    </th>
                    <th>
                        Funciones
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.FechaPedido)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Estado)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Observaciones)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CantidadProducto)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Cliente.Nombre)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Producto.Nombre)
                        </td>
                        <td>
                            <a class="waves-effect waves-light btn" asp-action="Edit" asp-route-id="@item.PedidoId"><i class="material-icons">edit</i> </a> |
                            <a class="waves-effect waves-light btn" asp-action="Details" asp-route-id="@item.PedidoId"><i class="material-icons">details</i></a> |
                            <a class="waves-effect waves-light btn" asp-action="Delete" asp-route-id="@item.PedidoId"><i class="material-icons">delete</i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </section>
    <br />
    <br />

    <footer class="row">
        <div class="col s12 l12">
            <p>
                Estamos ubicados en Manizales, Caldas, Colombia.<br />
                Universidad de Caldas. Tel: 8805903 - 3136462105.<br />
                <strong>Almacen J&D - 2025</strong> <br>
                Construye facil

            </p>
        </div>
    </footer>
</body>

