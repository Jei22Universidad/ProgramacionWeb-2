@model IEnumerable<WebFerreteria.Models.Usuario>

@{
    ViewData["Title"] = "Index1";
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    var alertMessage = TempData["AlertMessage"] as String;
    var alertText = TempData["AlertText"] as String;
    var alertType = TempData["AlertType"] as string;
}
<link rel="stylesheet" type="text/css" href="~/css/style_login.css" />

<body>
    <div class="col s12 l4">
        <div class="row Titulo">
            <h2>Almacen J&D</h2>
        </div>
    </div>
    <div class="carousel carousel-slider center">
        <div class="carousel-item white-text" href="#one!">
            <h2>Inicio Secion </h2>
            <form asp-action="Usuario" method="post">

            <div id="radioButon">
                    <p>
                        <label>
                            <input name="group1" type="radio" checked />
                            <span>admistrador</span>
                        </label>
                    </p>
                    <p>
                        <label>
                            <input name="group1" type="radio" />
                            <span>empleado</span>
                        </label>
                    </p>
            </div>
            <div class="row loginField">
                <div class="col s12 input-field">
                        <label for="username">Usuario</label>
                        <input type="text" id="username" name="username" />
                </div>
            </div>
            <div class="row loginField">
                <div class="col s12 input-field">
                    <label>Password</label>
                        <input type="password" id="password" name="password" />
                </div>

            </div>
        <button type="submit" class="btn waves-effect black-text darken-text-2">Ingresar</button>
            </form>

        </div>


        <!-- <div class="carousel-item black white-text" href="#two!">
            <h2>Inicio Secion Empleado</h2>
            <div class="row loginField">
                <div class="col s12 input-field">
                    <label for="txtUsuario">Usuario</label>
                    <input type="text" id="txtUsuario" name="txtUsuario" />
                </div>
            </div>
            <div class="row loginField">
                <div class="col s12 input-field">
                    <label>Password</label>
                    <input type="password" id="txtPassword" name="txtPassword" />
                </div>
            </div>
        </div> -->
        <!-- <div class="carousel-item green white-text" href="#three!">
          <h2>Third Panel</h2>
          <p class="white-text">This is your third panel</p>
        </div>
        <div class="carousel-item blue white-text" href="#four!">
          <h2>Fourth Panel</h2>
          <p class="white-text">This is your fourth panel</p>
        </div> -->
    </div>

</body>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (alertType != null && alertType.Any())
{
    <script type="text/javascript">

        Swal.fire({
            icon: "@alertType",
            title: "@alertMessage",
            showConfirmButton: false,
            text: "@alertText",
            timer: 1900
        });

    </script>
}